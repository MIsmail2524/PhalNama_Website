{
  "name": "phalnama",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/pricing.test.ts tests/phone.test.ts tests/safe.test.ts",
    "db:local": "node scripts/local-db.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "test:integration": "tsx --conditions=react-server --env-file=.env --test --test-concurrency=1 tests/flow.integration.test.ts",
    "test:e2e:db": "DATABASE_URL=postgresql://phalnama:phalnama@localhost:5432/phalnama_test prisma migrate reset --force --skip-generate",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build && npm run test:e2e:db && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "marked": "^18.1.3",
    "next": "15.5.29",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.13.0": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    },
    "@vercel/cli-config": {
      "zod": "^4.6.7"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
