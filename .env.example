# ── Core ─────────────────────────────────────────────
DATABASE_URL="postgresql://phalnama:phalnama@localhost:5432/phalnama"
# Public site URL (used for QR codes, referral links, sitemap, emails)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Long random string. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# First admin account (used once by `npm run db:seed` or `npm run admin:create`)
SEED_ADMIN_EMAIL="owner@phalnama.pk"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Owner"

# ── Image storage ────────────────────────────────────
# Leave empty to store uploads in public/uploads (local dev only).
# On Vercel, create a Blob store and paste its token here.
BLOB_READ_WRITE_TOKEN=""

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Phalnama <orders@phalnama.pk>"
ADMIN_NOTIFY_EMAIL=""

# ── WhatsApp Business Cloud API (Meta) ───────────────
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
ADMIN_NOTIFY_WHATSAPP=""

# ── Online payments ──────────────────────────────────
# "test" enables the development test gateway (never use in production).
# Leave empty until a real Pakistani gateway is integrated (see docs/INTEGRATIONS.md).
PAYMENT_GATEWAY=""
PAYMENT_GATEWAY_SECRET=""

# ── Scheduled jobs ───────────────────────────────────
# Vercel Cron sends this as a Bearer token to /api/cron/rewards
CRON_SECRET=""
